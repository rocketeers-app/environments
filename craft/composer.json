{
    "name": "rocketeers/craft",
    "description": "Craft CMS example environment",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "craftcms/cms": "^5.5.0",
        "vlucas/phpdotenv": "^5.4.1"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        },
        "platform": {
            "php": "8.2"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
